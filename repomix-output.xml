<file path="frontend/src/assets/components.css">
/* ============================================= */
/* SHARED COMPONENT STYLESHEET          */
/* ============================================= */
/* This file centralizes styles for components   */
/* used across multiple pages to avoid code      */
/* duplication and ensure consistency. It uses   */
/* the design tokens defined in DashboardCss.css.*/
/* ============================================= */


/* --------------- Cards --------------- */
/* A flexible base card for various content. */
/* Used in: Dashboard, Indices, Watchlist, etc. */
/* ------------------------------------------- */
.card {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  border: 1px solid var(--border-primary);
  border-radius: 1rem;
  box-shadow: 0 4px 6px -1px var(--shadow-primary), 0 0 0 1px rgba(255, 255, 255, 0.5) inset;
  transition: all 0.2s ease;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.dark .card {
  background: rgba(31, 41, 55, 0.9);
  box-shadow: 0 4px 6px -1px var(--shadow-primary), 0 0 0 1px rgba(75, 85, 99, 0.5) inset;
}

.card:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 15px -3px var(--shadow-primary), 0 0 0 1px rgba(255, 255, 255, 0.7) inset;
}

.dark .card:hover {
  box-shadow: 0 10px 15px -3px var(--shadow-primary), 0 0 0 1px rgba(75, 85, 99, 0.7) inset;
}

.card-header {
  border-bottom: 1px solid var(--border-primary);
  padding: 1.5rem;
}

.card-title {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--text-primary);
}

.card-content {
  padding: 1.5rem;
  flex: 1;
}

/* --------------- Buttons --------------- */
/* Base styles and variants for all buttons. */
/* ----------------------------------------- */
.btn {
  padding: 0.75rem 1.5rem;
  font-size: 1rem;
  font-weight: 600;
  border: 1px solid transparent;
  border-radius: 0.5rem;
  cursor: pointer;
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}

.btn:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 4px 6px -1px var(--shadow-secondary);
}

.btn:disabled {
  opacity: 0.7;
  cursor: not-allowed;
  transform: none;
}

/* Primary action button (e.g., Login) */
.btn-primary {
  background: linear-gradient(135deg, var(--text-primary), var(--text-secondary));
  color: var(--bg-primary);
}
.btn-primary:hover:not(:disabled) {
  background: linear-gradient(135deg, var(--text-secondary), var(--text-primary));
}

/* Destructive action button (e.g., Sell, Logout) */
.btn-destructive {
    background: linear-gradient(to right, #dc2626, #b91c1c);
    color: var(--bg-primary);
}
.btn-destructive:hover:not(:disabled) {
    background: linear-gradient(to right, #b91c1c, #991b1b);
}

/* Constructive action button (e.g., Buy, Profit) */
.btn-constructive {
    background: linear-gradient(to right, #059669, #047857);
    color: var(--bg-primary);
}
.dark .btn-constructive {
    background: linear-gradient(to right, #10b981, #059669);
}
.btn-constructive:hover:not(:disabled) {
    background: linear-gradient(to right, #047857, #065f46);
}

/* Outline/Secondary button */
.btn-outline {
  background: transparent;
  border-color: var(--border-secondary);
  color: var(--text-primary);
}
.btn-outline:hover:not(:disabled) {
  background: var(--bg-secondary);
  border-color: var(--text-primary);
}


/* --------------- Loaders / Spinners --------------- */
/* For indicating loading states. */
/* -------------------------------------------------- */
.loader-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 200px; /* Or adjust as needed */
  gap: 1.5rem;
  padding: 2rem;
}

.loader-spinner {
  position: relative;
  width: 4rem;
  height: 4rem;
}

.loader-spinner .spinner-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border: 3px solid transparent;
  border-top: 3px solid var(--text-primary);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loader-spinner .spinner-ring:nth-child(2) {
  width: 80%;
  height: 80%;
  top: 10%;
  left: 10%;
  border-top-color: var(--text-secondary);
  animation-delay: -0.1s;
}

.loader-spinner .spinner-ring:nth-child(3) {
  width: 60%;
  height: 60%;
  top: 20%;
  left: 20%;
  border-top-color: var(--text-tertiary);
  animation-delay: -0.2s;
}

.loader-text {
  color: var(--text-secondary);
  font-size: 1.125rem;
  font-weight: 500;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}


/* --------------- Skeleton Loaders --------------- */
/* Placeholder for content that is loading. */
/* ---------------------------------------------- */
.skeleton-item {
  background: linear-gradient(90deg, var(--bg-tertiary), var(--bg-quaternary), var(--bg-tertiary));
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 0.375rem;
}

.skeleton-circle {
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 50%;
}

.skeleton-text {
  height: 1rem;
  flex: 1;
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}


/* --------------- Alerts & Messages --------------- */
/* For error messages, empty states, etc. */
/* ------------------------------------------------- */
.alert-destructive {
  padding: 1rem;
  text-align: center;
  background: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.2);
  color: #dc2626;
  border-radius: 0.5rem;
  font-weight: 500;
}
.dark .alert-destructive {
  background: rgba(248, 113, 113, 0.1);
  border: 1px solid rgba(248, 113, 113, 0.3);
  color: #f87171;
}

.empty-state {
  text-align: center;
  padding: 2rem;
  color: var(--text-tertiary);
}


/* --------------- Movers Component --------------- */
/* Combined styles for the Movers panel and buttons. */
/* Used in: Indices, Watchlist pages */
/* ------------------------------------------------ */
.movers-panel {
  margin-top: 2rem;
  padding: 1.5rem;
  border: 1px solid var(--border-primary);
  border-radius: 0.75rem;
  background: var(--bg-secondary);
  box-shadow: 0 4px 6px -1px var(--shadow-primary);
}

.movers-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--border-primary);
}

.movers-header h3 {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0;
  font-size: 1.1rem;
  font-weight: 600;
  color: var(--text-primary);
}

.movers-list {
  display: grid;
  gap: 0.75rem;
  grid-template-columns: 1fr;
}

@media (min-width: 640px) { .movers-list { grid-template-columns: repeat(2, 1fr); } }
@media (min-width: 1024px) { .movers-list { grid-template-columns: repeat(3, 1fr); } }

.mover-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.75rem;
  border-radius: 0.5rem;
  background: var(--bg-tertiary);
  border: 1px solid var(--border-primary);
}

.mover-symbol { font-weight: 600; color: var(--text-primary); }
.mover-price { color: var(--text-secondary); }

.mover-change {
  font-weight: 600;
  border-radius: 0.25rem;
  padding: 0.15rem 0.5rem;
}

.mover-change.gain { background: rgba(5, 150, 105, 0.1); color: #059669; }

# =============================================================================
# TradeEasy Backend Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file to version control!

# --- Flask Application ---
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_ENV=development  # Options: development, production
FLASK_DEBUG=True
HOST=0.0.0.0
PORT=5000

# --- Frontend Configuration ---
FRONTEND_URL=http://localhost:5173

# --- Database ---
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0
MONGO_DB_NAME=TradeEasy

# --- Motilal Oswal API Credentials ---
API_KEY=your-api-key
USER_ID=your-user-id
PASSWORD=your-password
TWO_FA=your-2fa-pin
TOTP_SECRET=your-totp-secret

# --- NEW: Motilal Oswal WebSocket Security ---
# Enable SSL verification for WebSocket connections (recommended: true for production)
# Set to false ONLY in dev/test environments if MO's SSL certificate is invalid
MO_WS_VERIFY_SSL=false

# --- Order Processing ---
ENABLE_ORDER_PROCESSOR=True

# --- Session Management ---
SESSION_LIFETIME_HOURS=8
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_TYPE=filesystem

# --- Security ---
BCRYPT_LOG_ROUNDS=12

# --- Logging ---
SUPPRESS_SOCKET_LOGS=True

# --- Motilal Oswal API Configuration ---
MO_BASE_URL=https://openapi.motilaloswal.com
MO_API_TIMEOUT=30
MO_API_CONNECT_TIMEOUT=10
MO_API_READ_TIMEOUT=30
MO_WS_DEBUG=false
MO_WS_SINGLE_PROCESS=true

# --- Socket.IO Configuration ---
SOCKETIO_PING_INTERVAL=25
SOCKETIO_PING_TIMEOUT=60

# --- Client Device Information (for MO API Headers) ---
MO_CLIENT_LOCAL_IP=127.0.0.1
MO_CLIENT_PUBLIC_IP=8.8.8.8
MO_CLIENT_MAC=00:11:22:33:44:55
MO_SOURCE_ID=WEB
MO_VENDOR_INFO=your-user-id
MO_OS_NAME=Windows
MO_OS_VERSION=10
MO_DEVICE_MODEL=TradeEasyWeb
MO_DEVICE_MANUFACTURER=Generic
MO_PRODUCT_NAME=TradeEasy
MO_PRODUCT_VERSION=1.0.0
MO_BROWSER_NAME=Chrome
MO_BROWSER_VERSION=105.0

# =============================================================================
# REFACTORING NOTES (January 2026)
# =============================================================================
#
# Recent Security & Performance Improvements:
#
# 1. MO_WS_VERIFY_SSL (NEW)
#    - Controls SSL certificate verification for MO WebSocket
#    - Default: true (secure)
#    - Set to false only in dev/test if needed
#
# 2. FLASK_ENV (IMPORTANT)
#    - Controls password reset token exposure
#    - development: Tokens returned in API response (for testing)
#    - production: Tokens NEVER exposed (email-only)
#
# 3. Atomic Database Operations
#    - All balance/quantity reservations now use MongoDB atomic updates
#    - Prevents race conditions in concurrent trading
#    - No configuration needed - automatically applied
#
# 4. Decimal Precision
#    - Monetary calculations now use Python Decimal internally
#    - Prevents floating-point rounding errors
#    - No configuration needed - automatically applied
#
# 5. Frontend Performance
#    - Filtered WebSocket subscriptions reduce re-renders
#    - Components only receive updates for their watched symbols
#    - No configuration needed - automatically applied
#
# =============================================================================
